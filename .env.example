# ============================================================
# Plataforma de Gestión de Recursos y Espacios de PLAi
# Plantilla de variables de entorno (estándar PLAi, sección 6)
# Copiar a .env.local para desarrollo. NUNCA subir valores reales.
# Valores de este archivo son ficticios.
# En producción los secretos se montan como Docker secrets en
# /run/secrets/<nombre> (patrón VARIABLE_FILE); los crea PLAi.
# ============================================================

# --- Runtime (no secreto) ---
# Entorno de ejecución: development | production
NODE_ENV=development
# Puerto de escucha de la aplicación (estándar PLAi: 3000)
PORT=3000
# Interfaz de escucha dentro del contenedor
HOSTNAME=0.0.0.0
# Desactiva la telemetría de Next.js (no secreto)
NEXT_TELEMETRY_DISABLED=1

# --- Públicas (NEXT_PUBLIC_*: llegan al navegador, NO colocar secretos) ---
# URL pública de la aplicación
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Integraciones futuras (descomentar al conectarlas) ---
# Directus (CMS/backoffice). SECRETO: DIRECTUS_TOKEN. Solo se usa en el servidor.
# DIRECTUS_URL=https://directus.example.plai.mx
# DIRECTUS_TOKEN=cambia-este-token-ficticio
# DIRECTUS_TOKEN_FILE=/run/secrets/directus_token

# NextAuth.js (autenticación). SECRETO: NEXTAUTH_SECRET. El proveedor lo define PLAi.
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=cambia-este-secreto-ficticio
# NEXTAUTH_SECRET_FILE=/run/secrets/nextauth_secret
