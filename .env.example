# ============================================================
# Plataforma de Gestión de Recursos y Espacios de PLAi
# Plantilla de variables de entorno (Estándar PLAi v1.0, Sección 6)
# Copiar a .env.local para desarrollo. NUNCA subir valores reales.
# En producción los secretos se montan como Docker secrets en
# /run/secrets/<nombre> (patrón VARIABLE_FILE); los administra PLAi.
# ============================================================

# --- Runtime (no secreto) ---
# Entorno de ejecución: development | production
NODE_ENV=development
# Puerto de escucha de la aplicación (estándar PLAi: 3000)
PORT=3000
# Interfaz de escucha dentro del contenedor
HOSTNAME=0.0.0.0
# Desactiva la telemetría de Next.js (no secreto)
NEXT_TELEMETRY_DISABLED=1

# --- Públicas (NEXT_PUBLIC_*: llegan al navegador, NO colocar secretos) ---
# URL pública de la aplicación
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Autenticación NextAuth.js (OBLIGATORIO en producción) ---
# URL canónica del portal para callbacks de sesión
NEXTAUTH_URL=http://localhost:3000
# SECRETO: clave aleatoria >= 32 bytes (ej. `openssl rand -base64 32`)
NEXTAUTH_SECRET=reemplazar-por-secreto-aleatorio-de-al-menos-32-caracteres
# En Docker Swarm, montar el secreto en /run/secrets/nextauth_secret y declarar:
# NEXTAUTH_SECRET_FILE=/run/secrets/nextauth_secret

# --- Autenticación Keycloak SSO (OIDC Institucional PLAi) ---
# URL del Realm emisor de Keycloak
KEYCLOAK_ISSUER=https://auth.plai.mx/realms/plai
# Identificador de cliente registrado en Keycloak
KEYCLOAK_ID=plai-recursos
# KEYCLOAK_ID_FILE=/run/secrets/keycloak_id
# SECRETO: Secreto de cliente si el cliente es confidencial
KEYCLOAK_SECRET=reemplazar-por-client-secret-keycloak
# KEYCLOAK_SECRET_FILE=/run/secrets/keycloak_secret

# --- Base de Datos PostgreSQL 16 / Neon (OBLIGATORIO) ---
# SECRETO: cadena de conexión PostgreSQL / Neon (incluir sslmode=require en Neon)
DATABASE_URL=postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/plai_recursos?sslmode=require
# En Docker Swarm, montar el secreto en /run/secrets/database_url y declarar:
# DATABASE_URL_FILE=/run/secrets/database_url
# Forzar SSL explícitamente si el servidor PostgreSQL lo requiere (true | false)
# DB_SSL=true

# --- Directus CMS Institucional (admin.plai.mx) ---
# URL base de la instancia de Directus
DIRECTUS_URL=https://admin.plai.mx
# SECRETO: Token estático de servicio de Directus
DIRECTUS_TOKEN=reemplazar-por-token-estatico-directus
# DIRECTUS_TOKEN_FILE=/run/secrets/directus_token
