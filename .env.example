# ============================================================
# Plataforma de Gestión de Recursos y Espacios de PLAi
# Plantilla de variables de entorno (Estándar PLAi v1.0, Sección 6)
# Copiar a .env.local para desarrollo. NUNCA subir valores reales.
# En producción los secretos se montan como Docker secrets con prefijo
# `plai_recursos_*` en /run/secrets/<nombre> (patrón VARIABLE_FILE).
#
# SUSTITUIR los valores en MAYÚSCULAS (`AQUI_HACER_CAMBIOS_CORRESPONDIENTES_...`)
# por las direcciones y credenciales institucionales reales.
# ============================================================

# --- Runtime (no secreto) ---
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# --- Públicas (NEXT_PUBLIC_*: llegan al navegador, NO colocar secretos) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# En producción: https://AQUI_HACER_CAMBIOS_CORRESPONDIENTES_CON_DOMINIO_INSTITUCIONAL_PLAI

# --- Autenticación NextAuth.js (OBLIGATORIO en producción) ---
NEXTAUTH_URL=http://localhost:3000
# SECRETO: clave aleatoria >= 32 bytes (`openssl rand -base64 32`)
NEXTAUTH_SECRET=AQUI_HACER_CAMBIOS_CORRESPONDIENTES_CON_SECRETO_32_BYTES
# En Docker Swarm:
# NEXTAUTH_SECRET_FILE=/run/secrets/plai_recursos_nextauth_secret

# --- Autenticación Keycloak SSO (ÚNICO proveedor de identidad, sin contraseñas locales) ---
KEYCLOAK_ISSUER=https://AQUI_HACER_CAMBIOS_CORRESPONDIENTES_CON_URL_KEYCLOAK_INSTITUCIONAL/realms/AQUI_REALM_PLAI
KEYCLOAK_ID=AQUI_HACER_CAMBIOS_CORRESPONDIENTES_CON_CLIENT_ID_KEYCLOAK
# KEYCLOAK_ID_FILE=/run/secrets/plai_recursos_keycloak_id
KEYCLOAK_SECRET=AQUI_HACER_CAMBIOS_CORRESPONDIENTES_CON_CLIENT_SECRET_KEYCLOAK
# KEYCLOAK_SECRET_FILE=/run/secrets/plai_recursos_keycloak_secret

# --- Directus CMS (Persistencia 100% vía API REST oficial; sin Postgres directo) ---
# IMPORTANTE: NO tiene valor por defecto para impedir escrituras accidentales desde local.
DIRECTUS_URL=https://AQUI_HACER_CAMBIOS_CORRESPONDIENTES_CON_URL_DIRECTUS_ADMIN_PLAI
# Prefijo de colecciones exclusivo de esta aplicación (evita colisiones en admin.plai.mx)
DIRECTUS_COLLECTION_PREFIX=lab_recursos_
# SECRETO DE RUNTIME (permisos mínimos exclusivamente sobre lab_recursos_*):
# NUNCA colocar aquí el token de administrador de Directus.
DIRECTUS_TOKEN=AQUI_HACER_CAMBIOS_CORRESPONDIENTES_CON_TOKEN_SERVICIO_DIRECTUS
# DIRECTUS_TOKEN_FILE=/run/secrets/plai_recursos_directus_token

# --- Solo scripts de aprovisionamiento (`pnpm directus:setup` / `pnpm directus:seed`) ---
# NO montar esta variable en el contenedor de la aplicación en producción.
# DIRECTUS_ADMIN_TOKEN=AQUI_HACER_CAMBIOS_CORRESPONDIENTES_CON_TOKEN_ADMIN_SOLO_SETUP

# --- Certificados TLS para nginx-plai-recursos (puerto 8443, TLS passthrough + PROXY protocol v2) ---
# En Docker Swarm se montan como bind mount de solo lectura desde el directorio de renovación Let's Encrypt:
# /opt/plai/plai-recursos/ssl/<DOMINIO> -> /etc/nginx/ssl (legible por UID 101)
# SSL_CERT_FILE=/etc/nginx/ssl/fullchain.pem
# SSL_KEY_FILE=/etc/nginx/ssl/privkey.pem
# TRUSTED_PROXY_CIDR=10.0.0.0/8
