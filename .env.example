# ============================================================
# Plataforma de Gestión de Recursos y Espacios de PLAi
# Plantilla de variables de entorno (estándar PLAi, sección 6)
# Copiar a .env.local para desarrollo. NUNCA subir valores reales.
# Valores de este archivo son ficticios.
# En producción los secretos se montan como Docker secrets en
# /run/secrets/<nombre> (patrón VARIABLE_FILE); los crea PLAi.
# ============================================================

# --- Runtime (no secreto) ---
# Entorno de ejecución: development | production
NODE_ENV=development
# Puerto de escucha de la aplicación (estándar PLAi: 3000)
PORT=3000
# Interfaz de escucha dentro del contenedor
HOSTNAME=0.0.0.0
# Desactiva la telemetría de Next.js (no secreto)
NEXT_TELEMETRY_DISABLED=1

# --- Públicas (NEXT_PUBLIC_*: llegan al navegador, NO colocar secretos) ---
# URL pública de la aplicación
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Integraciones futuras (descomentar al conectarlas) ---
# Directus (CMS/backoffice). SECRETO: DIRECTUS_TOKEN. Solo se usa en el servidor.
# DIRECTUS_URL=https://directus.example.plai.mx
# DIRECTUS_TOKEN=cambia-este-token-ficticio
# DIRECTUS_TOKEN_FILE=/run/secrets/directus_token


# --- Base de Datos Relacional (PostgreSQL 15/16 - Estándar PLAi Sec. 3) ---
# SECRETO: DB_PASSWORD (en producción usar Docker secret en /run/secrets/db_password)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=plai
DB_PASSWORD=cambia-esta-clave-ficticia-pg
DB_NAME=plai_recursos
# DB_SSL=false
# DB_PASSWORD_FILE=/run/secrets/db_password

# --- Autenticación (NextAuth) ---
# En producción NEXTAUTH_SECRET es OBLIGATORIO (SECRETO; usar NEXTAUTH_SECRET_FILE / Docker secret).
# Sin él la aplicación no firma sesiones. Generar con: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cambia-este-secreto-ficticio-de-al-menos-32-caracteres

# --- Cuentas de demostración (solo desarrollo/evaluación) ---
# Fuera de producción están activas con contraseñas locales por defecto.
# En producción están DESACTIVADAS salvo DEMO_LOGIN_ENABLED=true (no recomendado).
# DEMO_LOGIN_ENABLED=false
# DEMO_ADMIN_PASSWORD=cambia-esto (SECRETO; también DEMO_ADMIN_PASSWORD_FILE)
# DEMO_USER_PASSWORD=cambia-esto  (SECRETO; también DEMO_USER_PASSWORD_FILE)