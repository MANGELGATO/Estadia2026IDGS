# ==============================================================================
# CONFIGURACIÓN NGINX REVERSE PROXY UNPRIVILEGED (TLS PASSTHROUGH) - PLAi v1.0
# - Escucha HTTPS (TLS 1.2/1.3) en puerto 8443 para Traefik TLS passthrough.
# - Puerto 8080 expone ÚNICAMENTE /nginx-health (healthcheck local) y redirección 301 a HTTPS.
# - Nunca sirve la aplicación por HTTP plano (garantiza cookies __Secure- de NextAuth).
# - Resolución DNS dinámica de Swarm (127.0.0.11): no falla si `app` arranca después.
# - Rechaza SNI/Host no autorizados (ssl_reject_handshake on en 8443, 444 en 8080).
# ==============================================================================

worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 1024;
  use epoll;
  multi_accept on;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  server_tokens off;

  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 65;
  types_hash_max_size 2048;
  client_max_body_size 10M;

  # Rutas temporales dentro de /tmp (compatible con read_only: true y UID 101)
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;

  # Manejo correcto de Connection para WebSockets vs HTTP normal
  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
  }

  log_format plai_json escape=json '{'
    '"timestamp":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"host":"$host",'
    '"request_method":"$request_method",'
    '"request_uri":"$request_uri",'
    '"status":$status,'
    '"body_bytes_sent":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"ssl_protocol":"$ssl_protocol",'
    '"http_referrer":"$http_referer",'
    '"http_user_agent":"$http_user_agent"'
  '}';

  access_log /dev/stdout plai_json;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 6;
  gzip_types
    text/plain
    text/css
    text/xml
    application/json
    application/javascript
    application/xml+rss
    application/atom+xml
    image/svg+xml;

  limit_req_zone $binary_remote_addr zone=general_limit:10m rate=20r/s;
  limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/s;

  # --------------------------------------------------------------------------
  # Puerto 8080: EXCLUSIVAMENTE healthcheck local y redirección a HTTPS.
  # La aplicación NUNCA se sirve por HTTP plano.
  # --------------------------------------------------------------------------
  server {
    listen 8080 default_server;
    server_name _;

    location = /nginx-health {
      access_log off;
      return 200 "ok\n";
    }

    location / {
      return 444;
    }
  }

  server {
    listen 8080;
    server_name ${ALLOWED_HOST};

    location = /nginx-health {
      access_log off;
      return 200 "ok\n";
    }

    location / {
      return 301 https://$host$request_uri;
    }
  }

  # --------------------------------------------------------------------------
  # Puerto 8443: Terminación TLS directa (Traefik TCP/TLS passthrough)
  # --------------------------------------------------------------------------
  server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
  }

  server {
    listen 8443 ssl;
    http2 on;
    server_name ${ALLOWED_HOST};

    ssl_certificate     ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_KEY_FILE};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # DNS interno de Docker Swarm para resolución dinámica del servicio `app`
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $upstream_app http://app:3000;

    # Cabeceras de seguridad complementarias sobre HTTPS
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Bloquear archivos ocultos y rutas sensibles (.env, .git, etc.)
    location ~ /\.(?!well-known) {
      deny all;
      return 404;
    }

    # Activos estáticos inmutables de Next.js
    location /_next/static/ {
      limit_except GET HEAD {
        deny all;
      }
      proxy_pass $upstream_app;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Connection "";
      expires 365d;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
      add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
      add_header X-Content-Type-Options "nosniff" always;
      access_log off;
    }

    # Endpoint de salud de la app (sin rate limit)
    location = /api/health {
      limit_except GET HEAD {
        deny all;
      }
      proxy_pass $upstream_app;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Port 443;
      access_log off;
    }

    # Endpoints de autenticación (rate limiting estricto + protocolo HTTPS fijo)
    location /api/auth/ {
      limit_except GET POST HEAD OPTIONS {
        deny all;
      }
      limit_req zone=auth_limit burst=10 nodelay;
      proxy_pass $upstream_app;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Port 443;
      proxy_set_header X-Forwarded-Host $host;
    }

    # Tráfico general hacia Next.js
    location / {
      limit_except GET POST PUT PATCH DELETE HEAD OPTIONS {
        deny all;
      }
      limit_req zone=general_limit burst=30 nodelay;
      proxy_pass $upstream_app;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Port 443;
      proxy_set_header X-Forwarded-Host $host;

      proxy_connect_timeout 30s;
      proxy_send_timeout 60s;
      proxy_read_timeout 60s;
    }
  }
}
