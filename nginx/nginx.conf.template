# ==============================================================================
# CONFIGURACIÓN NGINX REVERSE PROXY UNPRIVILEGED - ESTÁNDAR PLAi v1.0
# - Escucha en puerto 8080 (no privilegiado, compatible con cap_drop: [ALL] y UID 101).
# - Resolución DNS dinámica de Swarm (127.0.0.11): no falla si `app` arranca después.
# - Rechaza cabeceras Host no autorizadas (default_server -> 444).
# - Preserva X-Forwarded-Proto y X-Forwarded-Port desde Traefik.
# - Healthcheck propio en /nginx-health desacoplado de la app.
# ==============================================================================

worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 1024;
  use epoll;
  multi_accept on;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  server_tokens off;

  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 65;
  types_hash_max_size 2048;
  client_max_body_size 10M;

  # Rutas temporales dentro de /tmp (compatible con read_only: true y UID 101)
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;

  # Manejo correcto de Connection para WebSockets vs HTTP normal (no manda Upgrade siempre)
  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
  }

  # Preservar protocolo y puerto reales terminados en Traefik/Gateway
  map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
  }

  map $http_x_forwarded_port $forwarded_port {
    default $http_x_forwarded_port;
    ''      $server_port;
  }

  log_format plai_json escape=json '{'
    '"timestamp":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"host":"$host",'
    '"request_method":"$request_method",'
    '"request_uri":"$request_uri",'
    '"status":$status,'
    '"body_bytes_sent":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"http_referrer":"$http_referer",'
    '"http_user_agent":"$http_user_agent"'
  '}';

  access_log /dev/stdout plai_json;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 6;
  gzip_types
    text/plain
    text/css
    text/xml
    application/json
    application/javascript
    application/xml+rss
    application/atom+xml
    image/svg+xml;

  limit_req_zone $binary_remote_addr zone=general_limit:10m rate=20r/s;
  limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/s;

  # Bloque por defecto: rechaza cualquier petición con Host distinto al dominio autorizado
  # (excepto /nginx-health para el HEALTHCHECK local en 127.0.0.1)
  server {
    listen 8080 default_server;
    server_name _;

    location = /nginx-health {
      access_log off;
      return 200 "ok\n";
    }

    location / {
      return 444;
    }
  }

  server {
    listen 8080;
    server_name ${ALLOWED_HOST};

    # DNS interno de Docker Swarm para resolución dinámica del servicio `app`
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $upstream_app http://app:3000;

    # Cabeceras de seguridad complementarias
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Healthcheck propio de Nginx (desacoplado de Next.js)
    location = /nginx-health {
      access_log off;
      return 200 "ok\n";
    }

    # Bloquear archivos ocultos y rutas sensibles (.env, .git, etc.)
    location ~ /\.(?!well-known) {
      deny all;
      return 404;
    }

    # Activos estáticos inmutables de Next.js
    location /_next/static/ {
      limit_except GET HEAD {
        deny all;
      }
      proxy_pass $upstream_app;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Connection "";
      expires 365d;
      add_header Cache-Control "public, max-age=31536000, immutable";
      access_log off;
    }

    # Endpoint de salud de la app (sin rate limit)
    location = /api/health {
      limit_except GET HEAD {
        deny all;
      }
      proxy_pass $upstream_app;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_set_header X-Forwarded-Port $forwarded_port;
      access_log off;
    }

    # Endpoints de autenticación (rate limiting estricto)
    location /api/auth/ {
      limit_except GET POST HEAD OPTIONS {
        deny all;
      }
      limit_req zone=auth_limit burst=10 nodelay;
      proxy_pass $upstream_app;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_set_header X-Forwarded-Port $forwarded_port;
      proxy_set_header X-Forwarded-Host $host;
    }

    # Tráfico general hacia Next.js
    location / {
      limit_except GET POST PUT PATCH DELETE HEAD OPTIONS {
        deny all;
      }
      limit_req zone=general_limit burst=30 nodelay;
      proxy_pass $upstream_app;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_set_header X-Forwarded-Port $forwarded_port;
      proxy_set_header X-Forwarded-Host $host;

      proxy_connect_timeout 30s;
      proxy_send_timeout 60s;
      proxy_read_timeout 60s;
    }
  }
}
